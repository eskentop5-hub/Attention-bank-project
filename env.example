# ===== ATTENTION BANK v11 — настройки =====
# Скопируйте этот файл в .env (локально) или задайте те же переменные в Render → Environment.
# Секреты (пароли, токены, ключи) никогда не коммитьте в Git.

# ----- Сервер -----
PORT=3000
# Публичный адрес сайта без «/» в конце: ссылки в Telegram, письмах, превью ссылок, sitemap
PUBLIC_URL=http://localhost:3000
# Файл настоящей базы SQLite (создаётся автоматически). В v11 по умолчанию ./data/app.db
DB_PATH=./data/app.db
# Брать IP из X-Forwarded-For (за прокси Render). По умолчанию включено, если PUBLIC_URL на onrender.com
# TRUST_PROXY=1
# Самопинг раз в 10 минут, чтобы бесплатный Render не засыпал. По умолчанию — на onrender.com
# KEEP_AWAKE=

# ----- Настоящее приложение и демо-песочница -----
# Песочница: кнопка «Демо» открывает отдельную базу в памяти с тестовыми студиями и заданиями.
# Настоящие аккаунты и баллы она не затрагивает. 1 — включена, 0 — выключена.
DEMO_SANDBOX=1
# Через сколько часов песочница сама возвращается к исходным данным
DEMO_RESET_HOURS=6
# Заполнить НАСТОЯЩУЮ базу демо-данными (только для локальной разработки!). В продакшене — 0.
SEED_DEMO=0
# Старый режим v10: вся основная база работает как демо (пополнение без оплаты). В продакшене — 0.
DEMO_MODE=0

# ----- Администратор -----
# Аккаунт администратора создаётся (или получает права) при запуске. Пароль — МИНИМУМ 10 символов:
# с более коротким паролем администратор не создаётся (в логе и при входе будет подсказка).
# Этот email зарезервирован: зарегистрироваться с ним через сайт нельзя.
# Админ-панель: войти этим email → раздел «Пульт» (#/admin).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ----- Деньги: пополнение по счёту и выводы -----
# Реквизиты получателя для счёта студии. Перевод строки — \n
# Пример: ТОО «Название»\nБИН 000000000000\nIBAN KZ00 0000 0000 0000 0000\nБанк …
BILLING_DETAILS=
# Контакт для вопросов по оплате (Telegram, email или телефон) — показывается в счёте и при восстановлении пароля
BILLING_CONTACT=
# Минимальная сумма пополнения, AB
TOPUP_MIN_AB=100

# ----- Экономика -----
# Сколько тенге стоит 1 AB
AB_TO_KZT=10
# Комиссия платформы с каждого ПОДТВЕРЖДЁННОГО результата, % от награды
PLATFORM_FEE_PERCENT=20
# Комиссия платформы с продажи награды (продавец получает остальное), %
SELLER_FEE_PERCENT=10
# Минимальная сумма вывода выручки продавцом, AB
PAYOUT_MIN_AB=500
# Базовый лимит ответов в сутки (уровень тестировщика добавляет +5 за уровень)
DAILY_SUBMISSION_LIMIT=10
# Бонус пригласившему, когда друг подтвердил Telegram и получил первое одобренное задание (платит платформа из комиссий)
REFERRAL_BONUS=20
# Сколько регистраций в час с одного IP (защита от накруток; для занятий в классе можно поднять)
REGISTER_PER_HOUR=60

# ----- Резервные копии базы (нужны для бесплатного Render: там диск стирается при каждом деплое) -----
# САМЫЙ ПРОСТОЙ СПОСОБ (v12, без новых переменных): задайте TELEGRAM_BOT_TOKEN, войдите администратором
# и привяжите Telegram (Профиль → Подключить Telegram). Копия базы будет храниться закреплённым документом
# в вашем чате с ботом и сама восстановится после перезапуска (в режиме webhook).
# Необязательно: другой чат для копий (например, в режиме polling) — его ID узнаёт команда /chatid
TELEGRAM_BACKUP_CHAT_ID=
#
# ИЛИ любое S3-совместимое хранилище (если задано — используется вместо Telegram): Cloudflare R2 (есть бесплатный объём), Backblaze B2, Yandex Object Storage, AWS S3.
# Копия делается каждые BACKUP_INTERVAL_MIN минут при изменениях и при остановке сервера;
# при запуске на пустом диске база восстанавливается из последней копии.
# Пример для R2: https://<account-id>.r2.cloudflarestorage.com, регион auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
BACKUP_PREFIX=attention-bank
BACKUP_INTERVAL_MIN=1
BACKUP_KEEP=48

# ----- Письма (восстановление пароля, подтверждение email) -----
# resend или brevo. Без ключа ссылки для пароля уходят в привязанный Telegram или выдаются администратором.
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Отправитель, подтверждённый у провайдера, например «ATTENTION BANK <no-reply@ваш-домен>»
EMAIL_FROM=

# ----- Telegram -----
# Токен бота от @BotFather. Без токена сайт работает, уведомления пишутся в консоль сервера.
TELEGRAM_BOT_TOKEN=
# Имя бота без @
TELEGRAM_BOT_USERNAME=
# ID группы/канала для публикации новых заданий (бот должен быть админом)
TELEGRAM_GROUP_ID=
# polling (просто, работает везде) или webhook (нужен HTTPS)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=change-me
# Бонус за подтверждение аккаунта через Telegram, AB (0 — без бонуса)
TELEGRAM_VERIFY_BONUS=10
# Час ежедневного напоминания о серии (по TZ_OFFSET_MIN)
REMINDER_HOUR=19

# ----- Маскот «Аби» (необязательно) -----
# Ключ Anthropic API: маскот отвечает через Claude. Без ключа — встроенная база знаний.
# v13: с этим ключом Аби — настоящий ИИ (Claude) с инструментами приложения и поиском в интернете.
# Ключ: console.anthropic.com → API Keys (оплата по использованию). Без ключа Аби работает в офлайн-режиме команд.
ANTHROPIC_API_KEY=
MASCOT_MODEL=claude-haiku-5-5
MASCOT_QUESTIONS_PER_HOUR=20

# ----- Статистика -----
# Часовой пояс для «дней» (минуты от UTC). Казахстан: 300 (UTC+5)
TZ_OFFSET_MIN=300
# Ежедневный челлендж: сколько заданий в день (только прогресс, без бонусных баллов)
DAILY_CHALLENGE_TASKS=3
